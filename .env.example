# Copy to .env for local development. Never commit .env.
# Full reference: apps/api/src/platform/config.ts
NODE_ENV=development
DATABASE_URL=postgres://ibc:ibc_dev_password@localhost:5432/ibc
LOG_LEVEL=info
PORT=3000
# Comma-separated browser origins allowed to call the API (empty = CORS disabled).
CORS_ALLOWED_ORIGINS=http://localhost:3001
# Public web app URL used in email links.
APP_BASE_URL=http://localhost:3001
# Email: "log" prints emails (dev only); "ses" sends via Amazon SES (required in production).
EMAIL_TRANSPORT=log
EMAIL_FROM=IBC <no-reply@localhost>
AWS_REGION=ap-south-1
# Tracing (optional): set to an OTLP/HTTP collector (e.g. http://localhost:4318) to enable.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_TRACES_SAMPLER_ARG=1
# Website accounts (read by apps/web on the server; never exposed to the browser).
# IBC_API_URL=http://localhost:3000
# IBC_SITE_ORIGIN=http://localhost:3001   # required in production
# IBC_TRUSTED_PROXY_HOPS=0
# Integration tests (must point at a database whose name ends in _test).
TEST_DATABASE_URL=postgres://ibc:ibc_dev_password@localhost:5432/ibc_test
