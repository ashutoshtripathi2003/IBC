{
  "name": "@ibc/api",
  "version": "0.0.0",
  "private": true,
  "description": "IBC platform API service (identity, sessions, health; event outbox).",
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "engines": {
    "node": ">=22.15 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --conditions=@ibc/source --env-file-if-exists=../../.env src/main.ts",
    "dev:worker": "tsx --conditions=@ibc/source --env-file-if-exists=../../.env src/worker.ts",
    "db:migrate": "tsx --conditions=@ibc/source --env-file-if-exists=../../.env src/migrate.ts",
    "start": "node --import ./dist/telemetry.js dist/main.js",
    "start:worker": "node --import ./dist/telemetry.js dist/worker.js",
    "migrate": "node dist/migrate.js",
    "openapi:export": "tsx --conditions=@ibc/source src/openapi-export.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1161.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@ibc/kernel": "workspace:*",
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
