{
  "name": "@ibc/web",
  "version": "0.0.0",
  "private": true,
  "description": "IBC public website (Next.js).",
  "type": "module",
  "engines": {
    "node": ">=22.15 <25"
  },
  "scripts": {
    "predev": "pnpm --filter @ibc/kernel build",
    "dev": "next dev --port 3001",
    "prebuild": "pnpm --filter @ibc/kernel build",
    "build": "next build",
    "build:export": "node scripts/export-static.mjs",
    "start": "next start --port 3001",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@ibc/kernel": "workspace:*",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "motion": "14.9.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0"
  }
}
